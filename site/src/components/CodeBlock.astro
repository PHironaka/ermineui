---
import { Code } from 'astro:components'

interface Props {
  code: string
  lang?: 'vue' | 'ts' | 'sh' | 'css' | 'astro' | 'json' | 'toml'
  /** A file name or other caption above the code. */
  label?: string
}
const { code, lang = 'vue', label } = Astro.props
---

<div class="code">
  {label && <div class="code-label">{label}</div>}
  <button class="copy" type="button" data-copy style={label ? 'top: 2.9rem' : undefined}>Copy</button>
  <Code code={code} lang={lang} themes={{ light: 'github-light-high-contrast', dark: 'github-dark-high-contrast' }} defaultColor={false} />
</div>
