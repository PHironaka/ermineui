{
  "name": "ermineui-workspace",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Ermine UI — copy-in Vue 3 components styled with plain CSS variables.",
  "scripts": {
    "dev": "vite playground",
    "build": "vite build playground",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "registry": "node scripts/build-registry.mjs",
    "ermine": "node cli/bin/ermine.mjs",
    "check:registry": "node scripts/build-registry.mjs && node scripts/check-registry.mjs",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run check:registry && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsqr": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
